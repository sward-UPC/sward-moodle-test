# Configuración para seed.sh
# Copia este archivo a seed/.env y edita los valores

# URL base de Moodle
MOODLE_URL=http://localhost:8090

# Token WS generado desde Moodle admin
# Para generarlo: Moodle Admin > Plugins > Web Services > Manage Tokens
# O ve al README para instrucciones detalladas
MOODLE_TOKEN=your_token_here

# Opcionales (puedes pasarlas como variables de entorno también)
# NUM_COURSES=3
# NUM_TEACHERS=2
# NUM_STUDENTS=10
