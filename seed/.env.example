# Copia este archivo a seed/.env y completa el token generado en Moodle.
#   cp seed/.env.example seed/.env

# URL base del Moodle dockerizado (debe coincidir con el puerto publicado).
MOODLE_URL=http://localhost:8090

# Token del Web Service generado en:
#   Site administration -> Server -> Web services -> Manage tokens
MOODLE_TOKEN=pega-aqui-tu-token
